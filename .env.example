# ─────────────────────────────────────────────────────────────────────────────
# IWC website — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (canonical links, sitemap, structured data). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.iwcmainline.com

# ── Sanity CMS (required) ────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer-role token: lets the site show DRAFTS in Preview mode. Server-only.
SANITY_API_READ_TOKEN=
# Editor-role token: only for `npm run seed` and maintenance scripts. Not needed on Vercel.
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity publish webhook → /api/revalidate. Long random string.
SANITY_REVALIDATE_SECRET=

# ── Website assistant (OpenAI) ───────────────────────────────────────────────
# Without a key the assistant shows an "unavailable" state with phone/email.
OPENAI_API_KEY=
# Optional tuning (defaults shown).
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=900

# ── Rate limiting (Upstash Redis; strongly recommended in production) ───────
# Vercel Marketplace → Upstash Redis. Without these, limits are per-instance memory only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional salt for hashing visitor IPs in rate-limit keys.
RATE_LIMIT_SALT=

# ── Forms (Resend email delivery) ────────────────────────────────────────────
# Without these, forms show an honest "not connected yet — please call" message.
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend, e.g. website@iwcmainline.com
CONTACT_FROM_EMAIL=
# Where general inquiries go (comma-separate multiple addresses).
CONTACT_TO_EMAIL=
# Optional: separate inbox for provider/referral contacts (falls back to CONTACT_TO_EMAIL).
PROVIDER_TO_EMAIL=
# Optional: Resend audience for newsletter sign-ups (otherwise the office is emailed).
RESEND_AUDIENCE_ID=
# Optional: signs anti-spam form tokens (falls back to SANITY_REVALIDATE_SECRET).
FORM_SECRET=

# ── Optional Cloudflare Turnstile (extra bot protection on forms) ───────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics ────────────────────────────────────────────────────────────────
# GA4 measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Search indexing is OFF unless this is exactly "true". Set it on the production
# environment only after the client approves launch, then redeploy.
SITE_INDEXABLE=
